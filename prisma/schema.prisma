// Read-only: Tabelle wird von project-shop (Manage) verwaltet.
// Spaltennamen müssen mit Prisma-Modell in project-shop übereinstimmen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SupplierTrackingLink {
  id        String    @id
  entityId  String
  tokenHash String    @unique
  label     String?
  revokedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("supplier_tracking_links")
}

model EntityCredential {
  id        String   @id
  entityId  String
  key       String
  value     String
  updatedAt DateTime

  @@unique([entityId, key])
  @@map("entity_credentials")
}
