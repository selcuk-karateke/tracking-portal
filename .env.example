# Pflicht für Phase 2+3: dieselbe PostgreSQL-Datenbank wie project-shop
# (inkl. supplier_tracking_links + entity_credentials).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Für decrypt von shopify_access_token aus entity_credentials (AES-256-GCM wie Manage)
ENCRYPTION_KEY=""

# Optional: Shopify Admin API-Version (Default in Code: 2026-01)
# SHOPIFY_API_VERSION="2026-01"

# Öffentliche Manage-URL — Shop-Logos liegen dort unter /uploads/logos/{entityId}.(png|jpg)
# (gleicher Pfad wie in project-shop; Volume ggf. auch lokal unter public/uploads/logos mounten)
# MANAGE_PUBLIC_URL="https://manage.dachpro.com"
