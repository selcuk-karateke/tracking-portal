# Pflicht für Phase 2+3: dieselbe PostgreSQL-Datenbank wie project-shop
# (inkl. supplier_tracking_links + entity_credentials).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Für decrypt von shopify_access_token aus entity_credentials (AES-256-GCM wie Manage)
ENCRYPTION_KEY=""

# Optional: Shopify Admin API-Version (Default in Code: 2026-01)
# SHOPIFY_API_VERSION="2026-01"

# Shop-Logos (Manage: public/uploads/logos/{entityId}.png|jpg|jpeg)
#
# Empfohlen (Coolify): dasselbe Persistent Volume wie Manage am Portal mounten:
#   Destination: /app/public/uploads  (Volume-Name z. B. wie bei Manage)
# Dann liest das Portal die Dateien direkt — MANAGE_PUBLIC_URL ist optional.
#
# Alternative ohne Shared Volume: öffentliche Manage-Basis-URL — Portal ruft dann u. a.
# GET {MANAGE_PUBLIC_URL}/api/tracking/public/entity-logo?token=… (Route in project-shop).
# Statische /uploads/logos/… auf Coolify oft unzuverlässig.
# MANAGE_PUBLIC_URL="https://dev.dachpro.com"
# MANAGE_TRACKING_PORTAL_SECRET=""  # optional, wenn Manage Secret-Header unterstützt
# LOGO_UPLOADS_DIR=""               # optional, absoluter Pfad statt public/uploads/logos
